{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "agentic-inbox",
    "compatibility_date": "2025-11-28",
    "main": "./workers/app.ts",
    "observability": {
        "enabled": true,
    },
    "compatibility_flags": ["nodejs_compat"],
    "routes": [
        {
            "pattern": "inboxies.email",
            "custom_domain": true,
            "enabled": true,
            "previews_enabled": false,
        },
    ],
    "vars": {
        // Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
        // TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
        // The worker now fails closed outside local development if Access is not configured.
        // Mailbox domain(s) for create-address UI and Email Routing.
        // Optional MAIL_DOMAIN overrides the primary suffix; DOMAINS is comma-separated.
        // When both unset, API falls back to inboxies.email (hosted SaaS default only).
        // "MAIL_DOMAIN": "mail.example.com",
        "DOMAINS": "inboxies.email",
        "EMAIL_ADDRESSES": [],
        // Domain Admin allowlist (comma-separated Access emails and optional sub:…).
        // Set via `wrangler secret put DOMAIN_ADMINS` or vars in non-prod.
        // "DOMAIN_ADMINS": "you@example.com",
        // Recommended once admins exist: "MAILBOX_CREATE_POLICY": "admin_only",
        "APNS_SANDBOX": "true",
        "APNS_TOPIC": "co.inboxies.app",
    },
    "send_email": [
        {
            "name": "EMAIL",
            "remote": true,
        },
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "agentic-inbox",
            "preview_bucket_name": "agentic-inbox",
        },
    ],
    "ai": {
        "binding": "AI",
    },
    // Per-IP throttle on 6-digit password reset code guesses.
    // namespace_id must be unique among rate limiters in the Cloudflare account.
    "ratelimits": [
        {
            "name": "PASSWORD_RESET_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 10,
                "period": 60,
            },
        },
    ],
    "queues": {
        "consumers": [
            {
                "queue": "email-sending-events",
                "max_batch_size": 10,
                "max_retries": 5,
            },
        ],
    },
    // Serve only from the custom domain. Preview URLs would run old versions
    // against production R2, Durable Objects and email sending.
    "workers_dev": false,
    "preview_urls": false,
    "durable_objects": {
        "bindings": [
            {
                "name": "MAILBOX",
                "class_name": "MailboxDO",
            },
            {
                "name": "EMAIL_AGENT",
                "class_name": "EmailAgent",
            },
            {
                "name": "EMAIL_MCP",
                "class_name": "EmailMCP",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["MailboxDO"],
        },
        {
            "tag": "v2",
            "new_sqlite_classes": ["EmailAgent"],
        },
        {
            "tag": "v3",
            "new_sqlite_classes": ["EmailMCP"],
        },
    ],
}
