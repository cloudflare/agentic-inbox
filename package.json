{
	"name": "mail-portal",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"cloudflare": {
		"label": "Mail Portal",
		"products": [
			"Workers",
			"Durable Objects",
			"R2",
			"Queues",
			"Workers AI"
		],
		"bindings": {
			"DOMAINS": {
				"description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
			}
		}
	},
	"scripts": {
		"assets:wiser": "node scripts/generate-wiser-assets.mjs",
		"build": "node scripts/run-environment-artifact.mjs whispyr build",
		"build:whispyr": "node scripts/run-environment-artifact.mjs whispyr build",
		"build:wiser": "node scripts/run-environment-artifact.mjs wiser build",
		"cf-typegen": "wrangler types --env whispyr",
		"cf-typegen:wiser": "wrangler types --env wiser",
		"deploy:whispyr": "node scripts/run-environment-artifact.mjs whispyr deploy",
		"deploy:wiser": "node scripts/run-environment-artifact.mjs wiser deploy",
		"dev:whispyr": "CLOUDFLARE_ENV=whispyr react-router dev",
		"dev:wiser": "CLOUDFLARE_ENV=wiser react-router dev",
		"dev": "npm run dev:whispyr",
		"preview:whispyr": "npm run build:whispyr && vite preview",
		"preview:wiser": "npm run build:wiser && vite preview",
		"test": "node --experimental-strip-types --test --test-concurrency=4 'workers/**/*.test.ts' 'app/**/*.test.ts' 'shared/**/*.test.ts' 'scripts/**/*.test.mjs'",
		"test:workerd:emergency-forward-send": "node scripts/verify-emergency-forward-send-shape.mjs",
		"test:workerd:inbound-exact-size": "node scripts/verify-inbound-exact-size-workerd.mjs",
		"pretest:playwright:folder-create": "npm run test:playwright:install",
		"test:playwright:folder-create": "node scripts/verify-folder-create-playwright.mjs",
		"pretest:playwright:create-replay": "npm run test:playwright:install",
		"test:playwright:create-replay": "node scripts/verify-folder-create-playwright.mjs",
		"pretest:playwright:automation-dry-run": "npm run test:playwright:install",
		"test:playwright:automation-dry-run": "node scripts/verify-folder-create-playwright.mjs",
		"pretest:playwright:attachment-retry": "npm run test:playwright:install",
		"test:playwright:attachment-retry": "node scripts/verify-attachment-retry-playwright.mjs",
		"pretest:playwright:email-body": "npm run test:playwright:install",
		"test:playwright:email-body": "node scripts/verify-email-body-playwright.mjs",
		"pretest:playwright:email-list-errors": "npm run test:playwright:install",
		"test:playwright:email-list-errors": "node scripts/verify-email-body-playwright.mjs --email-list-only",
		"pretest:playwright:polish-journey": "npm run test:playwright:install",
		"test:playwright:polish-journey": "node scripts/verify-polish-journey-playwright.mjs",
		"test:playwright:install": "playwright install chromium",
		"canary:email-authorization": "node scripts/run-email-authorization-canary.mjs",
		"transition:wiser-shared-mailboxes": "node scripts/transition-wiser-shared-mailboxes.mjs",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"typecheck:wiser": "npm run cf-typegen:wiser && react-router typegen && tsc -b",
		"verify:env:whispyr": "node scripts/run-environment-artifact.mjs whispyr verify",
		"verify:env:wiser": "node scripts/run-environment-artifact.mjs wiser verify",
		"verify:envs": "npm run verify:env:whispyr && npm run verify:env:wiser"
	},
	"dependencies": {
		"@ai-sdk/react": "^3.0.118",
		"@cloudflare/ai-chat": "^0.1.8",
		"@cloudflare/kumo": "^1.13.0",
		"@cloudflare/workers-oauth-provider": "^0.7.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.99.0",
		"@tiptap/extension-color": "3.20.2",
		"@tiptap/extension-highlight": "3.20.2",
		"@tiptap/extension-image": "3.20.2",
		"@tiptap/extension-link": "3.20.2",
		"@tiptap/extension-text-align": "3.20.2",
		"@tiptap/extension-text-style": "3.20.2",
		"@tiptap/extension-underline": "3.20.2",
		"@tiptap/react": "3.20.2",
		"@tiptap/starter-kit": "3.20.2",
		"@zone-eu/mailsplit": "5.4.14",
		"agents": "^0.7.6",
		"ai": "^6.0.116",
		"aws4fetch": "^1.0.20",
		"dompurify": "^3.4.11",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.29",
		"isbot": "^5.1.27",
		"jose": "^6.2.1",
		"postal-mime": "^2.6.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"react-router": "^7.15.1",
		"remark-gfm": "^4.0.1",
		"workers-ai-provider": "^3.1.2",
		"zod": "^3.25.76",
		"zustand": "^5.0.12"
	},
	"overrides": {
		"@cloudflare/kumo": {
			"zod": "$zod"
		},
		"@tiptap/core": "3.20.2",
		"@tiptap/pm": "3.20.2",
		"@tiptap/extensions": "3.20.2",
		"@tiptap/extension-blockquote": "3.20.2",
		"@tiptap/extension-bold": "3.20.2",
		"@tiptap/extension-bubble-menu": "3.20.2",
		"@tiptap/extension-bullet-list": "3.20.2",
		"@tiptap/extension-code": "3.20.2",
		"@tiptap/extension-code-block": "3.20.2",
		"@tiptap/extension-document": "3.20.2",
		"@tiptap/extension-dropcursor": "3.20.2",
		"@tiptap/extension-floating-menu": "3.20.2",
		"@tiptap/extension-gapcursor": "3.20.2",
		"@tiptap/extension-hard-break": "3.20.2",
		"@tiptap/extension-heading": "3.20.2",
		"@tiptap/extension-horizontal-rule": "3.20.2",
		"@tiptap/extension-italic": "3.20.2",
		"@tiptap/extension-list": "3.20.2",
		"@tiptap/extension-list-item": "3.20.2",
		"@tiptap/extension-list-keymap": "3.20.2",
		"@tiptap/extension-ordered-list": "3.20.2",
		"@tiptap/extension-paragraph": "3.20.2",
		"@tiptap/extension-strike": "3.20.2",
		"@tiptap/extension-text": "3.20.2",
		"@hono/node-server": "1.19.14",
		"express-rate-limit": "8.5.2",
		"fast-uri": "3.1.3",
		"ip-address": "10.2.0",
		"js-yaml": "4.3.0",
		"linkify-it": "5.0.2",
		"lodash": "4.18.1",
		"markdown-it": "14.3.0",
		"path-to-regexp": "8.4.2",
		"picomatch": "4.0.5",
		"qs": "6.15.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.0.12",
		"@cloudflare/workers-types": "^4.20251128.0",
		"@react-router/dev": "^7.15.1",
		"@tailwindcss/vite": "^4.1.4",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^20.19.37",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"miniflare": "4.20260312.1",
		"playwright": "^1.61.1",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.1.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.3",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "^4.74.0"
	}
}
