<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release builds speak HTTPS only. The debug source set overrides this
         file to allow cleartext for local Workers (10.0.2.2). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
